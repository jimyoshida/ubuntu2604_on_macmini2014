# Example inventory for the personal (per-identity) workstation playbooks.
#
# Copy it, then replace the placeholders with real hosts:
#
#   cd _personal
#   cp inventory.ini.example inventory.ini
#
# inventory.ini is gitignored — it holds real hostnames and addresses.
#
# Each playbook takes its target host as an extra var, naming either a host or a group
# defined here:
#
#   ansible-playbook ai-agent/claude-code.yml -e host=ws01 -e target_user=alice
#
# Note the second var. Unlike _multi-user/, where the connecting account is incidental
# because everything lands in root-owned system paths, these playbooks provision one
# account's $HOME — so *which* account is a separate question from which account
# Ansible logs in as. ansible_user below is only the SSH login; the account being
# provisioned is target_user, and defaulting it to the connecting user would recreate
# the single-user bug this tree exists to avoid.
#
# The addresses below are from the RFC 5737 documentation range and route nowhere.

[workstations]
ws01 ansible_host=192.0.2.11
ws02 ansible_host=192.0.2.12

[workstations:vars]
# The account Ansible connects as. The playbooks declare remote_user: ubuntu, but an
# inventory ansible_user overrides that play keyword, and -e ansible_user=<name>
# overrides both. Set it here when the targets consistently use a different account.
ansible_user=ubuntu

# Uncomment when the key for these hosts is not the SSH client's default.
# ansible_ssh_private_key_file=~/.ssh/id_ed25519
